# Optional. Usually you can leave this unset if `codex` is on your PATH.
# On macOS with the ChatGPT desktop app, the server also checks:
# /Applications/ChatGPT.app/Contents/Resources/codex
CODEX_BIN=

# Codex-backed reading defaults.
KYOWA_CODEX_MODEL=gpt-5.6-luna
KYOWA_CODEX_EFFORT=none

# The app trims unfinished drafts before sending them to Codex.
KYOWA_MAX_DRAFT_CHARS=1800
KYOWA_MAX_OUTPUT_CHARS=520
KYOWA_MIN_CHANGED_CHARS=18

# Server-side throttle. The browser-side default debounce is 3 seconds.
KYOWA_MIN_SECONDS_BETWEEN_REQUESTS=3

# In-memory daily guardrails for local experimentation.
KYOWA_MAX_READS_PER_DAY=60
KYOWA_MAX_TOKENS_PER_DAY=650000
